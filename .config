# Minimal seed config for QSDK 12.5 (QuickXand/qsdk rax3000q-port)
# Target: ipq50xx / ipq50xx_32 subtarget / Device/cmcc_rax3000q
# Generate the full config inside Actions with `make defconfig`.
#
# Previous .config (kkstone QSDK 11.5 / immortalwrt 21.02) is saved as
# .config.qsdk11.5.bak for reference while porting.

CONFIG_TARGET_ipq50xx=y
CONFIG_TARGET_ipq50xx_ipq50xx_32=y
CONFIG_TARGET_DEVICE_ipq50xx_ipq50xx_32_DEVICE_cmcc_rax3000q=y
CONFIG_TARGET_DEVICE_PACKAGES_ipq50xx_ipq50xx_32_DEVICE_cmcc_rax3000q=""

# Use the in-tree kernel shipped with the QSDK tree (no separate download).
# Do NOT set CONFIG_EXTERNAL_KERNEL_TREE here: the ipq50xx Makefile has
# a fallback that resolves to $(TOPDIR)/qca/src/linux-5.4 when this is
# unset, and that absolute path is what toolchain/kernel-headers needs
# (a relative path like ./qca/src/linux-5.4 breaks the build when make
# descends into build_dir/).
CONFIG_LINUX_IS_FLATTENED_TREE=y

# Keep the build tiny on first-pass so we get an actionable V=s log.
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_KERNEL_SKB_EXTENSIONS=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
